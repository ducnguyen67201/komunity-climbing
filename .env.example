# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Create a Web OAuth client in Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed to review submitted climbs.
REVIEWER_EMAILS=

# Comma-separated frontend origins allowed to use the API in production.
CORS_ORIGIN=

# Optional. Defaults to 3001.
API_PORT=3001

# Create a key at https://platform.openai.com/api-keys and keep it server-side.
OPENAI_API_KEY=

# Cost-efficient default with image input and Structured Outputs support.
OPENAI_VISION_MODEL=gpt-6-luna
