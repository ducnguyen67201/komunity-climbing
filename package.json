{
  "name": "cak-climbing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "doppler run -- concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "start:api": "doppler run -- tsx server/index.ts"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@tanstack/react-query": "^5.103.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
